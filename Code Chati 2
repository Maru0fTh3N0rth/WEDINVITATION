            if (!saved) {

                alert(
                    "Es gibt keine gespeicherte Getränkeabstimmung zum Zurücknehmen."
                );

                return;

            }


            let drinks;


            try {

                drinks =
                    JSON.parse(saved);

            }

            catch (e) {

                alert(
                    "Die gespeicherte Auswahl konnte nicht gelesen werden."
                );

                return;

            }


            if (
                !confirm(
                    "Möchtest du deine Getränkeauswahl wirklich zurücknehmen?"
                )
            ) {

                return;

            }


            const success =
                await sendToGoogle({
                    type: "drinks",
                    action: "undo",
                    drinks: drinks
                });


            if (success) {

                localStorage.removeItem(
                    "hochzeitDrinks"
                );


                showDrinks();


                alert(
