        /* =====================================================
           GOOGLE APPS SCRIPT
        ====================================================== */

        async function sendToGoogle(data) {

            try {

                const response =
                    await fetch(
                        GOOGLE_SCRIPT_URL,
                        {

                            method:
                                "POST",

                            /*
                               KEINE speziellen Header setzen.
                               Dadurch vermeiden wir unnötige
                               CORS-Preflight-Probleme.
                            */

                            body:
                                JSON.stringify(data)

                        }
                    );


                const result =
                    await response.json();


                if (
                    result.success
                ) {

                    return true;

                }


                alert(
                    "Leider konnte die Abstimmung nicht gespeichert werden. 😕"
                );


                console.error(
                    result.error
                );


                return false;

            }


            catch (error) {

                console.error(
                    error
                );


                alert(

                    "Die Verbindung zum Abstimmungsserver hat leider nicht funktioniert. Bitte versuche es noch einmal. 🌸"

                );


                return false;

            }

        }


