                if (submit) {

                    submit.disabled =
                        true;

                    submit.textContent =
                        "Bereits abgestimmt ✓";

                }


                if (undo) {

                    undo.style.display =
                        "inline-block";

                }

            }


            else {

                status.innerHTML =
                    "Du hast hier noch nicht abgestimmt. 🌸";


                if (submit) {

                    submit.disabled =
                        false;

                    submit.textContent =
                        "Essensauswahl speichern 🍽️";

                }


                if (undo) {

                    undo.style.display =
                        "none";

                }

            }

        }



