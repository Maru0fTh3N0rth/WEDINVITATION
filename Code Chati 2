        async function submitDrinks() {

            const checkboxes =
                document.querySelectorAll(
                    '.drink-option input:checked'
                );


            const drinks =
                Array.from(
                    checkboxes
                ).map(
                    checkbox =>
                        checkbox.value
                );


            if (
                drinks.length === 0
            ) {

                alert(
                    "Bitte wähle mindestens ein Getränk aus. 🥂"
                );

                return;

            }


            const alreadyVoted =
                localStorage.getItem(
                    "hochzeitDrinks"
                );


            if (alreadyVoted) {

                alert(
                    "Du hast deine Getränke bereits ausgewählt. 😊"
                );

                return;

            }


            const button =
                document.getElementById(
                    "drinkSubmit"
                );


            button.disabled =
                true;


            button.textContent =
                "Wird gespeichert …";


            const success =
                await sendToGoogle({
                    type: "drinks",
                    action: "submit",
                    drinks: drinks
                });


            if (success) {

                localStorage.setItem(
                    "hochzeitDrinks",
                    JSON.stringify(drinks)
                );


                updateDrinkStatus();


                alert(
                    "Danke! Deine Getränkeauswahl wurde gespeichert. 🥂"
                );

            }


            else {

                button.disabled =
                    false;

                button.textContent =
                    "Getränke speichern 🥂";

            }

        }



