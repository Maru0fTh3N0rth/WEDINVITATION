        /* =====================================================
           RANKEN
        ====================================================== */

        .vine-left,
        .vine-right {

            position: fixed;

            top: 0;

            bottom: 0;

            width: 100px;

            pointer-events: none;

            z-index: 1;

            opacity: 0.35;

        }


        .vine-left {

            left: 0;

            border-left:
                2px solid
                rgba(104,118,99,0.6);

            border-radius:
                0 0 0 90%;

            transform:
                translateX(-45px)
                rotate(-4deg);

        }


        .vine-right {

            right: 0;

            border-right:
                2px solid
                rgba(104,118,99,0.6);

            border-radius:
                0 90% 0 0;

            transform:
                translateX(45px)
                rotate(4deg);

        }


        .vine-left::before,
        .vine-left::after,
        .vine-right::before,
        .vine-right::after {

            content: "❧";

            position: absolute;

            font-size: 40px;

            color:
                var(--gruen-dunkel);

        }


        .vine-left::before {

            top: 20%;

            right: -30px;

            transform:
                rotate(-25deg);

        }


        .vine-left::after {

            top: 70%;

            right: -30px;

            transform:
                rotate(15deg);

        }


        .vine-right::before {

            top: 35%;

            left: -30px;

            transform:
                scaleX(-1)
                rotate(-20deg);

        }


        .vine-right::after {

            top: 80%;

            left: -30px;

            transform:
                scaleX(-1)
                rotate(15deg);

        }



