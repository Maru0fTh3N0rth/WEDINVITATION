        /* =====================================================
           GRUNDLAYOUT
        ====================================================== */

        * {
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {

            margin: 0;

            min-height: 100vh;

            font-family:
                'Montserrat',
                sans-serif;

