        async function saveDrinkChoice() {

            const selected =
                document.querySelectorAll(
                    'input[name="drink"]:checked'
                );


            if (
                selected.length === 0
            ) {

                alert(
                    "Bitte wähle mindestens ein Getränk aus. 🥂"
                );

                return;

            }


            const drinks =
                Array.from(selected)
                    .map(
                        checkbox =>
                            checkbox.value
                    );


            const button =
                document.getElementById(
                    "drinkSaveButton"
                );


            button.disabled =
                true;


            button.textContent =
                "Wird gespeichert …";


            try {


                /*
                 * WICHTIG:
                 *
                 * Es wird ausschließlich
                 * das drinks-Array übertragen.
                 *
                 * Der Name des Gastes wird
                 * NICHT übertragen.
                 */


                await fetch(

                    GOOGLE_SCRIPT_URL,

                    {

                        method:
                            "POST",

                        mode:
                            "no-cors",

                        headers: {

                            "Content-Type":
                                "text/plain;charset=utf-8"

                        },

                        body:
                            JSON.stringify({

                                drinks:
                                    drinks

                            })

                    }

                );


                /*
                 * Doppelte Eingabe auf demselben
                 * Browser verhindern.
                 */

                localStorage.setItem(

                    "hochzeitGetraenkeGespeichert",

                    "true"

                );


                const success =
                    document.getElementById(
                        "drinkSuccess"
                    );


                success.style.display =
                    "block";


                success.innerHTML = `

                    <strong>
                        Vielen Dank! 🥂
                    </strong>

                    <br><br>

                    Deine Getränkeauswahl
                    wurde gespeichert.

                    <br><br>

                    Wir freuen uns,
                    mit dir anzustoßen! 🤍

                `;


                disableDrinkForm();


            } catch (error) {


                console.error(error);


                alert(

                    "Ups! Die Auswahl konnte leider nicht gespeichert werden. Bitte versuche es noch einmal. 💕"

                );


                button.disabled =
                    false;


                button.textContent =
                    "Auswahl speichern";

            }

        }



        /* =====================================================
