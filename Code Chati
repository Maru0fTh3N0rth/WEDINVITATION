async function submitFood() {

    const selected =
        document.querySelector(
            'input[name="food"]:checked'
        );

    const button =
        document.getElementById("foodSubmit");

    const message =
        document.getElementById("foodMessage");


    if (!selected) {

        message.innerHTML = `
            <p>
                Bitte wählt kurz aus,
                ob ihr mit zum Essen kommt. 🌸
            </p>
        `;

        return;
    }


    button.disabled = true;

    button.innerText =
        "Wird gespeichert …";


    try {

        const response =
            await fetch(
                GOOGLE_SCRIPT_URL,
                {
                    method: "POST",

                    body: JSON.stringify({

                        drinks: [],

                        essen: selected.value

                    })
                }
            );


        const result =
            await response.json();


        if (!result.success) {
            throw new Error(
                "Serverfehler"
            );
        }


        document.querySelectorAll(
            'input[name="food"]'
        ).forEach(
            radio => radio.disabled = true
        );


        button.style.display = "none";


        message.innerHTML = `

            <div class="food-success">

                <strong>
                    Perfekt! 🍽️💕
                </strong>

                <br><br>

                Eure Antwort ist angekommen.

                <br><br>

                Wir freuen uns auf euch! 🥂

            </div>

        `;


    } catch (error) {

        console.error(error);


        button.disabled = false;

        button.innerText =
            "Auswahl bestätigen 🍽️";


        message.innerHTML = `

            <p>

                <strong>
                    Huch! 😳
                </strong>

                <br><br>

                Die Antwort konnte gerade
                nicht gespeichert werden.

                <br><br>

                Bitte versucht es noch einmal.

            </p>

        `;

    }

}

