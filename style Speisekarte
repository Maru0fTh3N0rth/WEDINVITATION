/* ==================== SPEISEKARTE ==================== */

.menu-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 15px 0 25px 0;
    justify-content: center;
}

.menu-categories a {
    text-decoration: none;
    padding: 8px 13px;
    border-radius: 20px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--border-color, #ddd);
    color: var(--primary-color, #333);
    font-size: 0.9rem;
    transition: 0.2s ease;
}

.menu-categories a:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(0,0,0,0.08);
}

.menu-category {
    scroll-margin-top: 20px;
    margin-bottom: 28px;
}

.menu-category h3 {
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--accent-color, #8c2318);
    color: var(--accent-color, #8c2318);
}

.menu-entry {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
    padding: 10px 4px;
    border-bottom: 1px dashed var(--border-color, #ddd);
}

.menu-entry > div {
    flex: 1;
}

.menu-entry strong {
    display: block;
    font-size: 0.98rem;
}

.menu-entry small {
    display: block;
    margin-top: 3px;
    color: var(--text-muted, #777);
    font-size: 0.84rem;
    line-height: 1.4;
}

.menu-entry > span {
    white-space: nowrap;
    font-weight: bold;
    font-size: 0.95rem;
}

.menu-note {
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(140, 35, 24, 0.06);
    font-size: 0.9rem;
    font-weight: 600;
}

.menu-allergens {
    margin-top: 30px;
    padding: 15px;
    border-radius: 12px;
    background: rgba(0,0,0,0.035);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-muted, #777);
}

@media (max-width: 600px) {

    .menu-categories {
        justify-content: flex-start;
    }

    .menu-categories a {
        font-size: 0.82rem;
        padding: 7px 10px;
    }

    .menu-entry {
        gap: 8px;
    }

    .menu-entry strong {
        font-size: 0.92rem;
    }

    .menu-entry small {
        font-size: 0.78rem;
    }

    .menu-entry > span {
        font-size: 0.88rem;
    }
}
