```css
/* Speisekarte */
.menu-box {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
}

.menu-inner {
    margin-top: 25px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 25px;
}

.menu-intro {
    text-align: center;
    margin-bottom: 20px;
}

.menu-note {
    margin-top: 8px;
    font-size: 0.9rem;
    opacity: 0.75;
}

.menu-inner .section-title {
    margin-top: 30px;
}

.menu-inner .menu-item {
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

@media (max-width: 600px) {
    .menu-inner {
        padding: 15px;
    }

    .menu-inner .menu-item-header {
        flex-wrap: wrap;
    }
}
```
